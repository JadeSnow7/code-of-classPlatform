# MySQL
MYSQL_ROOT_PASSWORD=emfield_root
MYSQL_DATABASE=emfield
MYSQL_USER=emfield
MYSQL_PASSWORD=emfield_pass
MYSQL_HOST=mysql
MYSQL_PORT=3306

# Backend
BACKEND_HTTP_ADDR=0.0.0.0:8080
BACKEND_JWT_SECRET=change_me_in_prod
BACKEND_CORS_ORIGINS=http://localhost:5173
BACKEND_DB_DSN=emfield:emfield_pass@tcp(mysql:3306)/emfield?charset=utf8mb4&parseTime=True&loc=Local
BACKEND_AI_BASE_URL=http://ai:8001
BACKEND_SIM_BASE_URL=http://sim:8002
AI_GATEWAY_SHARED_TOKEN=change_me_gateway_token

# WeChat Work (企业微信) OAuth (optional)
WECOM_CORPID=
WECOM_AGENTID=
WECOM_SECRET=

# AI service runtime
APP_ENV=dev
LLM_ROUTING_POLICY=local_first
LLM_ENABLE_CLOUD_FALLBACK_NONPROD=false
LLM_LOCAL_TIMEOUT_SEC=30
LLM_CLOUD_TIMEOUT_SEC=60
AI_MULTIMODAL_ENABLED=false
RERANKER_ENABLED=false

# AI service local upstream (OpenAI-compatible)
LLM_BASE_URL_LOCAL=
LLM_API_KEY_LOCAL=
LLM_MODEL_LOCAL=qwen-plus
LLM_BASE_URL_LOCAL_TEXT=
LLM_API_KEY_LOCAL_TEXT=
LLM_MODEL_LOCAL_TEXT=qwen3
LLM_BASE_URL_LOCAL_VL=
LLM_API_KEY_LOCAL_VL=
LLM_MODEL_LOCAL_VL=qwen3-vl

# AI service cloud upstream (OpenAI-compatible)
LLM_BASE_URL_CLOUD=
LLM_API_KEY_CLOUD=
LLM_MODEL_CLOUD=qwen-plus
LLM_BASE_URL_CLOUD_TEXT=
LLM_API_KEY_CLOUD_TEXT=
LLM_MODEL_CLOUD_TEXT=qwen3
LLM_BASE_URL_CLOUD_VL=
LLM_API_KEY_CLOUD_VL=
LLM_MODEL_CLOUD_VL=qwen3-vl

# Backward-compatible single upstream vars (optional)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=qwen-plus

# GraphRAG (optional, local knowledge base)
GRAPH_RAG_ENABLED=false
GRAPH_RAG_INDEX_PATH=app/data/graphrag_index.json
GRAPH_RAG_SEED_TOP_K=4
GRAPH_RAG_EXPAND_HOPS=1
GRAPH_RAG_FINAL_TOP_K=8
GRAPH_RAG_MAX_CONTEXT_CHARS=4000
