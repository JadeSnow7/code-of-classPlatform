{
  "name": "mobile",
  "version": "1.0.0",
  "description": "classPlatform cross-platform desktop and mobile client",
  "author": "classPlatform Team",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "web:build": "expo export --platform web --output-dir dist-web",
    "electron:dev": "concurrently -k \"expo start --web --non-interactive --port 19006\" \"wait-on http://localhost:19006 && cross-env ELECTRON_DEV_URL=http://localhost:19006 electron ./electron/main.cjs\"",
    "electron:start": "npm run web:build && electron ./electron/main.cjs",
    "electron:pack": "npm run web:build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir",
    "electron:build": "npm run web:build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder",
    "test": "jest"
  },
  "dependencies": {
    "@classplatform/shared": "0.1.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.10.0",
    "@react-navigation/native": "^7.1.28",
    "@react-navigation/native-stack": "^7.10.0",
    "expo": "~54.0.31",
    "expo-dev-client": "~6.0.20",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.16",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.7.2",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "37.10.3",
    "electron-builder": "^26.0.12",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.4",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2",
    "wait-on": "^8.0.3"
  },
  "private": true,
  "build": {
    "appId": "com.classplatform.desktop",
    "productName": "classPlatform",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "dist-web/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "mac": {
      "category": "public.app-category.education",
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
