# Local AI service config for edge swift deploy integration.

APP_ENV=dev
LLM_ROUTING_POLICY=local_first
LLM_ENABLE_CLOUD_FALLBACK_NONPROD=false
EDGE_TUTOR_PROMPT_ENABLED=true

AI_MULTIMODAL_ENABLED=false
RERANKER_ENABLED=false
GRAPH_RAG_ENABLED=false

# Local upstream (OpenAI-compatible, ms-swift deploy)
LLM_BASE_URL_LOCAL=http://127.0.0.1:18080
LLM_API_KEY_LOCAL=edge-local-key
LLM_MODEL_LOCAL=qwen3-0.6b-edge-v1

# Text family explicit mapping (takes precedence in current AI service code)
LLM_BASE_URL_LOCAL_TEXT=http://127.0.0.1:18080
LLM_API_KEY_LOCAL_TEXT=edge-local-key
LLM_MODEL_LOCAL_TEXT=qwen3-0.6b-edge-v1

# Keep cloud unset in this round
LLM_BASE_URL_CLOUD=
LLM_API_KEY_CLOUD=
LLM_MODEL_CLOUD=

LLM_BASE_URL_CLOUD_TEXT=
LLM_API_KEY_CLOUD_TEXT=
LLM_MODEL_CLOUD_TEXT=

# Optional defaults used by some helper scripts
LLM_BASE_URL=http://127.0.0.1:18080
